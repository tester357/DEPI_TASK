using System;
using System.Collections.Generic;
using System.IO;

namespace ExaminationSystem
{
    public enum ExamMode
    {
        Starting,
        Queued,
        Finished
    }

    public enum QuestionType
    {
        TrueFalse,
        ChooseOne,
        ChooseAll
    }

    public class Answer : ICloneable, IComparable<Answer>
    {
        public int Id { get; set; }
        public string Text { get; set; }

        public Answer()
        {
        }

        public Answer(int id, string text) : this()
        {
            Id = id;
            Text = text;
        }

        public object Clone()
        {
            return new Answer(Id, Text);
        }

        public int CompareTo(Answer other)
        {
            if (other == null)
                return 1;

            return Id.CompareTo(other.Id);
        }

        public override string ToString()
        {
            return $"{Id}. {Text}";
        }

        public override bool Equals(object obj)
        {
            if (obj is Answer other)
                return Id == other.Id && Text == other.Text;

            return false;
        }

        public override int GetHashCode()
        {
            return HashCode.Combine(Id, Text);
        }
    }

    public class AnswerList : List<Answer>
    {
        public AnswerList()
        {
        }

        public AnswerList(IEnumerable<Answer> answers)
        {
            AddRange(answers);
        }

        public Answer FindById(int id)
        {
            foreach (Answer answer in this)
            {
                if (answer.Id == id)
                    return answer;
            }

            return null;
        }

        public override string ToString()
        {
            string result = "";

            foreach (Answer answer in this)
            {
                result += answer + Environment.NewLine;
            }

            return result;
        }
    }

    public abstract class Question : ICloneable, IComparable<Question>
    {
        public string Header { get; set; }
        public string Body { get; set; }
        public int Marks { get; set; }
        public AnswerList Answers { get; set; }
        public QuestionType Type { get; protected set; }

        protected Question()
        {
            Answers = new AnswerList();
        }

        protected Question(
            string header,
            string body,
            int marks,
            AnswerList answers) : this()
        {
            Header = header;
            Body = body;
            Marks = marks;
            Answers = answers ?? new AnswerList();
        }

        public abstract string Display();

        public abstract bool IsCorrect(List<int> answerIds);

        public abstract object Clone();

        public int CompareTo(Question other)
        {
            if (other == null)
                return 1;

            return Marks.CompareTo(other.Marks);
        }

        public override string ToString()
        {
            return Display();
        }

        public override bool Equals(object obj)
        {
            if (obj is Question other)
            {
                return Header == other.Header &&
                       Body == other.Body &&
                       Marks == other.Marks &&
                       Type == other.Type;
            }

            return false;
        }

        public override int GetHashCode()
        {
            return HashCode.Combine(Header, Body, Marks, Type);
        }
    }

    public class TrueFalseQuestion : Question
    {
        public int CorrectAnswerId { get; set; }

        public TrueFalseQuestion()
        {
            Type = QuestionType.TrueFalse;
        }

        public TrueFalseQuestion(
            string header,
            string body,
            int marks,
            AnswerList answers,
            int correctAnswerId) : base(header, body, marks, answers)
        {
            Type = QuestionType.TrueFalse;
            CorrectAnswerId = correctAnswerId;
        }

        public override string Display()
        {
            return $"{Header}\n{Body}\n{Answers}";
        }

        public override bool IsCorrect(List<int> answerIds)
        {
            return answerIds != null &&
                   answerIds.Count == 1 &&
                   answerIds[0] == CorrectAnswerId;
        }

        public override object Clone()
        {
            return new TrueFalseQuestion(
                Header,
                Body,
                Marks,
                new AnswerList(this.Answers),
                CorrectAnswerId
            );
        }
    }

    public class ChooseOneQuestion : Question
    {
        public int CorrectAnswerId { get; set; }

        public ChooseOneQuestion()
        {
            Type = QuestionType.ChooseOne;
        }

        public ChooseOneQuestion(
            string header,
            string body,
            int marks,
            AnswerList answers,
            int correctAnswerId) : base(header, body, marks, answers)
        {
            Type = QuestionType.ChooseOne;
            CorrectAnswerId = correctAnswerId;
        }

        public override string Display()
        {
            return $"{Header}\n{Body}\n{Answers}";
        }

        public override bool IsCorrect(List<int> answerIds)
        {
            return answerIds != null &&
                   answerIds.Count == 1 &&
                   answerIds[0] == CorrectAnswerId;
        }

        public override object Clone()
        {
            return new ChooseOneQuestion(
                Header,
                Body,
                Marks,
                new AnswerList(this.Answers),
                CorrectAnswerId
            );
        }
    }

    public class ChooseAllQuestion : Question
    {
        public List<int> CorrectAnswerIds { get; set; }

        public ChooseAllQuestion()
        {
            Type = QuestionType.ChooseAll;
            CorrectAnswerIds = new List<int>();
        }

        public ChooseAllQuestion(
            string header,
            string body,
            int marks,
            AnswerList answers,
            List<int> correctAnswerIds) : base(header, body, marks, answers)
        {
            Type = QuestionType.ChooseAll;
            CorrectAnswerIds = correctAnswerIds ?? new List<int>();
        }

        public override string Display()
        {
            return $"{Header}\n{Body}\n{Answers}";
        }

        public override bool IsCorrect(List<int> answerIds)
        {
            if (answerIds == null)
                return false;

            List<int> userAnswers = new List<int>(answerIds);
            userAnswers.Sort();

            List<int> correctAnswers = new List<int>(CorrectAnswerIds);
            correctAnswers.Sort();

            if (userAnswers.Count != correctAnswers.Count)
                return false;

            for (int i = 0; i < userAnswers.Count; i++)
            {
                if (userAnswers[i] != correctAnswers[i])
                    return false;
            }

            return true;
        }

        public override object Clone()
        {
            return new ChooseAllQuestion(
                Header,
                Body,
                Marks,
                new AnswerList(this.Answers),
                new List<int>(CorrectAnswerIds)
            );
        }
    }

    public class QuestionList : List<Question>
    {
        public string FileName { get; set; }

        public QuestionList(string fileName)
        {
            FileName = fileName;
        }

        public new void Add(Question question)
        {
            base.Add(question);

            using (TextWriter writer = new StreamWriter(FileName, true))
            {
                writer.WriteLine(question.ToString());
                writer.WriteLine("--------------------------------");
            }
        }

        public void LoadFromFile()
        {
            if (!File.Exists(FileName))
                return;

            using (TextReader reader = new StreamReader(FileName))
            {
                string line;

                while ((line = reader.ReadLine()) != null)
                {
                    Console.WriteLine(line);
                }
            }
        }
    }

    public class Subject
