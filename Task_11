List<string> employees = new List<string>();

employees.Add("Ahmed");
employees.Add("Sara");
employees.Add("Omar");

employees.Remove("Sara");

string searchName = "Omar";
bool found = false;
foreach (string name in employees)
{
    if (name == searchName)
    {
        found = true;
        break;
    }
}
Console.WriteLine(found ? $"{searchName} found." : $"{searchName} not found.");

Console.WriteLine("Final list:");
foreach (string name in employees)
{
    Console.WriteLine(name);
}

List<Employee> employeeList = new List<Employee>
{
    new Employee { Name = "Ahmed", Salary = 8000 },
    new Employee { Name = "Sara", Salary = 12000 },
    new Employee { Name = "Omar", Salary = 5000 }
};

double minSalary = 6000;

Console.WriteLine($"Employees with salary above {minSalary}:");
foreach (Employee emp in employeeList)
{
    if (emp.Salary > minSalary)
    {
        Console.WriteLine($"{emp.Name} - {emp.Salary}");
    }
}

