{
    static List<int> Filter(
        List<int> numbers,
        Predicate<int> condition)
    {
        List<int> result = new List<int>();

        foreach (int number in numbers)
        {
            if (condition(number))
            {
                result.Add(number);
            }
        }

        return result;
    }

    static void Main()
    {
        List<int> numbers =
            new List<int> { 1, 2, 3, 4, 5, 6 };

        List<int> even =
            Filter(numbers, number => number % 2 == 0);

