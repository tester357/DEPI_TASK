10) ICloneable Constraint
========================================================

using System;

class Employee : ICloneable
{
    public string Name { get; set; }
    public double Salary { get; set; }

    public object Clone()
    {
        return new Employee
        {
            Name = Name,
            Salary = Salary
        };
    }

    public override string ToString()
    {
        return Name + " - " + Salary;
    }
}

class SortingAlgorithm<T> where T : ICloneable
{
    public static T[] CloneArray(T[] array)
    {
        T[] result = new T[array.Length];

        for (int i = 0; i < array.Length; i++)
        {
            result[i] = (T)array[i].Clone();
        }

        return result;
    }
}

class Program
{
    static void Main()
    {
        Employee[] employees =
        {
            new Employee { Name = "Ahmed", Salary = 8000 },
            new Employee { Name = "Ali", Salary = 5000 }
        };

        Employee[] copy =
            SortingAlgorithm<Employee>.CloneArray(employees);

        foreach (Employee employee in copy)
            Console.WriteLine(employee);
    }
}

Question:
How do constraints improve type safety?

Answer:
They restrict T to types that satisfy specific requirements.
Here, T must implement ICloneable, so Clone() is guaranteed to exist.


