using System;
using System.Collections.Generic;

class Program
{
    public delegate string Transform(string text);

    static List<string> TransformList(
        List<string> list,
        Transform transform)
    {
        List<string> result = new List<string>();

        foreach (string text in list)
        {
            result.Add(transform(text));
        }

        return result;
    }

    static string Reverse(string text)
    {
        char[] chars = text.ToCharArray();
        Array.Reverse(chars);
        return new string(chars);
    }

    static void Main()
    {
        List<string> names =
            new List<string> { "Ahmed", "Ali", "Omar" };

        List<string> upper =
            TransformList(names, text => text.ToUpper());

        List<string> reversed =
            TransformList(names, Reverse);

        foreach (string name in upper)
            Console.WriteLine(name);

        Console.WriteLine();

        foreach (string name in reversed)
            Console.WriteLine(name);
    }
}

Question:
Benefits of delegates for transformations?

Answer:
They separate the transformation logic from the main function and
allow different transformations to be reused with the same method.


