using System;

namespace DEPI
{
    // ============================================================
    // 1. Car Class - Constructor Overloading
    // ============================================================
    class Car
    {
        public int Id { get; set; }
        public string Brand { get; set; }
        public double Price { get; set; }

        // 1. Default constructor
        public Car()
        {
            Id = 0;
            Brand = "Unknown";
            Price = 0;
        }

        // 2. Constructor with Id
        public Car(int id)
        {
            Id = id;
            Brand = "Unknown";
            Price = 0;
        }

        // 3. Constructor with Id and Brand
        public Car(int id, string brand)
        {
            Id = id;
            Brand = brand;
            Price = 0;
        }

        // 4. Constructor with Id, Brand and Price
        public Car(int id, string brand, double price)
        {
            Id = id;
            Brand = brand;
            Price = price;
        }

        public override string ToString()
        {
            return $"Car: Id = {Id}, Brand = {Brand}, Price = {Price}";
        }
    }


    // ============================================================
    // 2. Calculator - Method Overloading
    // ============================================================
    class Calculator
    {
        // Add two integers
        public int Sum(int a, int b)
        {
            return a + b;
        }

        // Add three integers
        public int Sum(int a, int b, int c)
        {
            return a + b + c;
        }

        // Add two doubles
        public double Sum(double a, double b)
        {
            return a + b;
        }
    }


    // ============================================================
    // 3. Parent and Child - Constructor Chaining
    // ============================================================
    class Parent
    {
        public int X { get; set; }
        public int Y { get; set; }

        public Parent(int x, int y)
        {
            X = x;
            Y = y;
        }

        public virtual int Product()
        {
            return X * Y;
        }

        public override string ToString()
        {
            return $"({X}, {Y})";
        }
    }

    class Child : Parent
    {
        public int Z { get; set; }

        // Constructor chaining to Parent
        public Child(int x, int y, int z)
            : base(x, y)
        {
            Z = z;
        }

        // Using new
        public new int Product()
        {
            return X * Y * Z;
        }

        public override string ToString()
        {
            return $"({X}, {Y}, {Z})";
        }
    }


    // ============================================================
    // 4. Child with override demonstration
    // ============================================================
    class ChildOverride : Parent
    {
        public int Z { get; set; }

        public ChildOverride(int x, int y, int z)
            : base(x, y)
        {
            Z = z;
        }

        // Using override
        public override int Product()
        {
            return X * Y * Z;
        }

        public override string ToString()
        {
            return $"({X}, {Y}, {Z})";
        }
    }


    // ============================================================
    // 5. Interface IShape
    // ============================================================
    interface IShape
    {
        double Area { get; }

        void Draw();

        // Default implementation - C# 8.0+
        void PrintDetails()
        {
            Console.WriteLine("This is a shape.");
        }
    }


    // Rectangle implements IShape
    class Rectangle : IShape
    {
        public double Width { get; set; }
        public double Height { get; set; }

        public Rectangle(double width, double height)
        {
            Width = width;
            Height = height;
        }

        public double Area
        {
            get { return Width * Height; }
        }

        public void Draw()
        {
            Console.WriteLine("Drawing Rectangle");
        }

        // Custom implementation of PrintDetails
        public void PrintDetails()
        {
            Console.WriteLine(
                $"Rectangle: Width = {Width}, Height = {Height}, Area = {Area}"
            );
        }
    }


    // ============================================================
    // 6. Circle implements IShape
    // ============================================================
    class Circle : IShape
    {
        public double Radius { get; set; }

        public Circle(double radius)
        {
            Radius = radius;
        }

        public double Area
        {
            get { return Math.PI * Radius * Radius; }
        }

        public void Draw()
        {
            Console.WriteLine("Drawing Circle");
        }

        // Uses default interface implementation
        // PrintDetails() is not written here.
    }


    // ============================================================
    // 7. IMovable Interface
    // ============================================================
    interface IMovable
    {
        void Move();
    }

    class MovingCar : IMovable
    {
        public void Move()
        {
            Console.WriteLine("Car is moving.");
        }

        public void StartEngine()
        {
            Console.WriteLine("Car engine started.");
        }
    }


    // ============================================================
    // 8. Multiple Interfaces
    // ============================================================
    interface IReadable
    {
        void Read();
    }

    interface IWritable
    {
        void Write();
    }

    class File : IReadable, IWritable
    {
        public void Read()
        {
            Console.WriteLine("Reading from file.");
        }

        public void Write()
        {
            Console.WriteLine("Writing to file.");
        }
    }


    // ============================================================
    // 9 & 10. Abstract Shape and Rectangle
    // ============================================================
    abstract class Shape
    {
        // Virtual method
        public virtual void Draw()
        {
            Console.WriteLine("Drawing Shape");
        }

        // Abstract method
        public abstract double CalculateArea();
    }

    class ShapeRectangle : Shape
    {
        public double Width { get; set; }
        public double Height { get; set; }

        public ShapeRectangle(double width, double height)
        {
            Width = width;
            Height = height;
        }

        // Override virtual method
        public override void Draw()
        {
            Console.WriteLine("Drawing Rectangle");
        }

        // Implement abstract method
        public override double CalculateArea()
        {
            return Width * Height;
        }
    }


    // ============================================================
    // MAIN
    // ============================================================
    class Program
    {
        static void Main()
        {
            // ====================================================
            // 1. Constructor Overloading
            // ====================================================
            Console.WriteLine("===== 1. CAR CONSTRUCTORS =====");

            Car car1 = new Car();
            Car car2 = new Car(1);
            Car car3 = new Car(2, "BMW");
            Car car4 = new Car(3, "Mercedes", 50000);

            Console.WriteLine(car1);
            Console.WriteLine(car2);
            Console.WriteLine(car3);
            Console.WriteLine(car4);


            // ====================================================
            // 2. Method Overloading
            // ====================================================
            Console.WriteLine("\n===== 2. CALCULATOR =====");

            Calculator calc = new Calculator();

            Console.WriteLine("Sum(10, 20) = " + calc.Sum(10, 20));
            Console.WriteLine("Sum(10, 20, 30) = " + calc.Sum(10, 20, 30));
            Console.WriteLine("Sum(10.5, 20.5) = " + calc.Sum(10.5, 20.5));


            // ====================================================
            // 3. Constructor Chaining
            // ====================================================
            Console.WriteLine("\n===== 3. CONSTRUCTOR CHAINING =====");

            Child child = new Child(10, 20, 30);

            Console.WriteLine("X = " + child.X);
            Console.WriteLine("Y = " + child.Y);
            Console.WriteLine("Z = " + child.Z);


            // ====================================================
            // 4. new vs override
            // ====================================================
            Console.WriteLine("\n===== 4. NEW VS OVERRIDE =====");

            // new keyword
            Child childNew = new Child(2, 3, 4);
            Parent parentNew = childNew;

            Console.WriteLine("Child reference with new:");
            Console.WriteLine(childNew.Product());

            Console.WriteLine("Parent reference with new:");
            Console.WriteLine(parentNew.Product());


            // override keyword
            ChildOverride childOverride =
                new ChildOverride(2, 3, 4);

            Parent parentOverride = childOverride;

            Console.WriteLine("\nChild reference with override:");
            Console.WriteLine(childOverride.Product());

            Console.WriteLine("Parent reference with override:");
            Console.WriteLine(parentOverride.Product());


            // ====================================================
            // 5. ToString() and Polymorphism
            // ====================================================
            Console.WriteLine("\n===== 5. TOSTRING AND POLYMORPHISM =====");

            Parent p = new Parent(10, 20);
            Parent c = new ChildOverride(10, 20, 30);

            Console.WriteLine(p.ToString());
            Console.WriteLine(c.ToString());


            // ====================================================
            // 6. IShape and Rectangle
            // ====================================================
            Console.WriteLine("\n===== 6. ISHAPE AND RECTANGLE =====");

            IShape rectangle = new Rectangle(10, 5);

            rectangle.Draw();
            Console.WriteLine("Area = " + rectangle.Area);

            rectangle.PrintDetails();


            // ====================================================
            // 7. Default Interface Implementation
            // ====================================================
            Console.WriteLine("\n===== 7. DEFAULT INTERFACE METHOD =====");

            IShape circle = new Circle(5);

            circle.Draw();
            Console.WriteLine("Area = " + circle.Area);

            // Calls PrintDetails() from IShape
            circle.PrintDetails();


            // ====================================================
            // 8. Interface Reference
            // ====================================================
            Console.WriteLine("\n===== 8. INTERFACE REFERENCE =====");

            IMovable movableCar = new MovingCar();

            movableCar.Move();

            // Only IMovable members are accessible here.
            // movableCar.StartEngine(); // ERROR


            // ====================================================
            // 9. Multiple Interfaces
            // ====================================================
            Console.WriteLine("\n===== 9. MULTIPLE INTERFACES =====");

            File file = new File();

            file.Read();
            file.Write();


            // ====================================================
            // 10. Virtual vs Abstract
            // ====================================================
            Console.WriteLine("\n===== 10. VIRTUAL VS ABSTRACT =====");

            Shape shape = new ShapeRectangle(10, 5);

            shape.Draw();

            Console.WriteLine(
                "Area = " + shape.CalculateArea()
            );
        }
    }
}
