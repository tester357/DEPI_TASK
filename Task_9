class Person
{
    public virtual double Salary { get; set; }
}

class Child : Person
{
    public sealed override double Salary
    {
        get { return 5000; }
        set { }
    }

    public void DisplaySalary()
    {
        Console.WriteLine("Salary = " + Salary);
    }
}

class Program
{
    static void Main()
    {
        Child child = new Child();
        child.DisplaySalary();
    }
}

