14) Non-Generic Swap
========================================================

struct Rectangle
{
    public double Length { get; set; }
    public double Width { get; set; }
}

class Program
{
    static void Swap(ref Rectangle r1, ref Rectangle r2)
    {
        Rectangle temp = r1;
        r1 = r2;
        r2 = temp;
    }

    static void Main()
    {
        Rectangle r1 = new Rectangle
        {
            Length = 10,
            Width = 5
        };

        Rectangle r2 = new Rectangle
        {
            Length = 20,
            Width = 8
        };

        Swap(ref r1, ref r2);

        Console.WriteLine(r1.Length);
        Console.WriteLine(r2.Length);
    }
}

Question:
Why is a generic Swap preferable?

Answer:
Because one generic method can work with many different types instead
of creating a separate Swap method for every type.


