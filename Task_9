class Department
{
    public string Name { get; set; }

    public override bool Equals(object obj)
    {
        Department department = obj as Department;

        if (department == null)
            return false;

        return Name == department.Name;
    }

    public override int GetHashCode()
    {
        return Name.GetHashCode();
    }
}

class Employee
{
    public string Name { get; set; }
    public Department Department { get; set; }

    public override bool Equals(object obj)
    {
        Employee employee = obj as Employee;

        if (employee == null)
            return false;

        return Department.Equals(employee.Department);
    }

    public override int GetHashCode()
    {
        return Department.GetHashCode();
    }
}

Question:
How does overriding Equals improve Department searches?

Answer:
It allows departments with the same logical value, such as the same
Name, to be considered equal even if they are different objects.


