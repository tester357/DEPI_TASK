abstract class shap
{
    void GetArea(){}

    void Display()
    {
        Console.WriteLine("Shape displayed.");
    }
}

class Rectangle : shap
{
    public int w;
    public int h;

    public  double GetArea(int wi,int  hi)
    {
        w = wi;
        h = hi;
        return w * h;
    }
}

class Circle : shap
{
    public const double BY=3.14;
    public double radius;

    public double GetArea(int R)
    {
        radius = R ;
        return radius * radius * R;
    }
}



