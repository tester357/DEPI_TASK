class Product
{
    private double price;
    private string name;
    private int ID;
    public Product(int id, string n, double p)
    {
        ID = id;
        name = n;
        price = p;
    }

    public int CompareTo(Product other)
    {
        return price.CompareTo(other.price);
    }
    
}


